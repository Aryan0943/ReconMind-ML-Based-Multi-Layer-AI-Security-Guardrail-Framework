# ReconMind Server Configuration
APP_NAME=ReconMind
APP_VERSION=1.0.0
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=reconmind
# Fallback to local file store if MongoDB is offline: true/false
USE_DEV_FALLBACK_DB=true

# Security Guardrail Thresholds (0.0 to 1.0)
INPUT_DEFENSE_THRESHOLD=0.75
MEMORY_DEFENSE_THRESHOLD=0.70
RETRIEVAL_DEFENSE_THRESHOLD=0.65

# Model paths (relative to backend/ or absolute)
BINARY_MODEL_PATH=app/ml/models/binary_pipeline.joblib
MULTICLASS_MODEL_PATH=app/ml/models/multiclass_pipeline.joblib
MODEL_METADATA_PATH=app/ml/models/model_metadata.json
