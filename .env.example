# ReconMind Environment Configuration Template
# Copy this file to .env and adjust variables as required

APP_NAME=ReconMind
APP_VERSION=1.0.0
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# Storage Configuration
# Set to 'false' if MongoDB daemon is active on localhost:27017
USE_DEV_FALLBACK_DB=true
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=reconmind

# Guardrail Detection Thresholds (0.0 to 1.0)
INPUT_DEFENSE_THRESHOLD=0.75
MEMORY_DEFENSE_THRESHOLD=0.70
RETRIEVAL_DEFENSE_THRESHOLD=0.65
TOOL_DEFENSE_THRESHOLD=0.50
OUTPUT_DEFENSE_THRESHOLD=0.50

# Security Rules
DEFAULT_ACTION=BLOCK
ENABLE_TELEMETRY_LOGS=true
